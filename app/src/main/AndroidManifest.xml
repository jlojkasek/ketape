<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:label="@string/app_name" android:icon="@drawable/ic_stacked" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <meta-data android:name="io.hammerhead.karooext.MANIFEST_URL" android:value="https://github.com/jlojkasek/karoo-stacked-fields-releases/releases/latest/download/manifest.json"/>
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".StackedExtension" android:exported="true">
            <intent-filter><action android:name="io.hammerhead.karooext.KAROO_EXTENSION"/></intent-filter>
            <meta-data android:name="io.hammerhead.karooext.EXTENSION_INFO" android:resource="@xml/extension_info"/>
        </service>
    </application>
</manifest>
